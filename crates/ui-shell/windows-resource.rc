IDI_APP_ICON ICON "@IRIS_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @IRIS_FILE_VERSION@
PRODUCTVERSION @IRIS_PRODUCT_VERSION@
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Iris\0"
            VALUE "FileVersion", "@IRIS_FILE_VERSION_STRING@\0"
            VALUE "InternalName", "Iris\0"
            VALUE "OriginalFilename", "Iris.exe\0"
            VALUE "ProductName", "Iris\0"
            VALUE "ProductVersion", "@IRIS_PRODUCT_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
